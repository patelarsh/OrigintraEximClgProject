# ===============================================================
# Origintra Exim - Hostinger LiteSpeed / Apache SPA Routing Rules
# ===============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical 301 Redirect: Enforce https://www.origintra.com (unifies indexing and merges split link equity)
  RewriteCond %{HTTP_HOST} ^origintra\.com$ [NC]
  RewriteRule ^(.*)$ https://www.origintra.com/$1 [R=301,L]

  # 2. API Endpoints: Route clean API URLs directly to PHP handlers
  RewriteRule ^api/send-mail/?$ /api/send-mail.php [L]
  RewriteRule ^api/verify-smtp/?$ /api/verify-smtp.php [L]

  # 3. Existing physical files and directories: Serve directly without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. React Single Page Application (SPA) Fallback:
  # Rewrite all virtual routes (/schedule-meeting, /products, /about, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Block access to sensitive files
<FilesMatch "(^\.|\.(sql|sqlite|db|env|log|md|sh|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# MIME Types for WebP, modern fonts, and icons
<IfModule mod_mime.c>
  AddType image/x-icon .ico
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType text/xsl .xsl
  AddType application/xml .xml
  AddType application/font-woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Gzip Compression for fast delivery on Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
